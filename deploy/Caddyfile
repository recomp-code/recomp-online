# HTTPS para el API de recomp-online (certificado gratis de Let's Encrypt, se renueva solo).
# install.sh lo copia a /etc/caddy/recomp-online.caddy con TU_DOMINIO cambiado y lo IMPORTA desde el Caddyfile
# principal: tus otros sitios no se tocan.
TU_DOMINIO {
	# el lobby en vivo va por WebSocket (/api/ws): Caddy lo pasa tal cual, sin búfer
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}
